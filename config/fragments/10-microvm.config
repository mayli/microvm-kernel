# Ubuntu microvm guest overrides.
# Applied after the Firecracker base config, ci.config and efi.config.

# No loadable modules at all.  This also guarantees that no '=m' entry can
# survive olddefconfig.
CONFIG_MODULES=n

# GPT partition-table parsing.  efi.config already sets this; keep it explicit
# because the target disk is GPT even though the VPS boots via BIOS/GRUB.
CONFIG_EFI_PARTITION=y

# No /dev/mem in a public kernel.
# CONFIG_DEVMEM is not set

# Headless guest: no keyboard/serial input stack.
# CONFIG_SERIO is not set
# CONFIG_SERIO_I8042 is not set
# CONFIG_SERIO_LIBPS2 is not set
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_INPUT_KEYBOARD is not set

# Not needed by the guest.  Ubuntu 7.0.0-43.43 also has a latent DAMON
# compile error (mm/damon/core.c uses min_sz_region instead of the function
# parameter min_region_sz); generic builds hide it with CONFIG_DAMON=n.
# CONFIG_DAMON is not set

# Keep the build config available at /proc/config.gz.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Allow both GPT and MBR images.
CONFIG_MSDOS_PARTITION=y
